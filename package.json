{
  "name": "nomtf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit && wrangler deploy --dry-run",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply nomtf-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply nomtf-db --remote"
  },
  "dependencies": {
    "hono": "^4.10.7"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "playwright-core": "^1.59.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.85.0"
  }
}
